NODE_ENV=development
HOST=0.0.0.0
PORT=3333
CORS_ORIGIN=http://localhost:5173

DATABASE_PATH=./data/minisynth32.sqlite

# Set SERIAL_MOCK=false and SERIAL_PORT=/dev/ttyACM0 for a real ESP32-S3.
SERIAL_MOCK=true
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD_RATE=115200

# In production, point this to ../frontend/dist after running the frontend build.
FRONTEND_DIST=../frontend/dist
